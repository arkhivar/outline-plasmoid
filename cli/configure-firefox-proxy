#!/usr/bin/env python3
"""
Configure Firefox SOCKS5 proxy for all existing profiles.

Usage:
    configure-firefox-proxy                        # enable proxy on all profiles
    configure-firefox-proxy clear                  # clear proxy from all profiles
"""
import json
import os
import sys
from pathlib import Path

PROXY_TYPE_LINE = 'user_pref("network.proxy.type", 1);'
PROXY_TYPE_CLEAR = 'user_pref("network.proxy.type", 0);'
OUTLINE_MARKER = "Auto-configured by Outline SS CLI"


def _find_firefox_profiles():
    """Find all Firefox profile directories by scanning for prefs.js.

    This is much more reliable than checking for .parentlock (which only
    exists while Firefox is running).  We operate on *every* profile so
    that stale proxy settings are never left behind after a reboot /
    crash / session end.
    """
    firefox_dir = Path.home() / ".config" / "mozilla" / "firefox"

    if not firefox_dir.exists():
        # Fallback: traditional ~/.mozilla location
        firefox_dir = Path.home() / ".mozilla" / "firefox"
    if not firefox_dir.exists():
        rel = Path.home() / "snap" / "firefox" / "common" / ".mozilla" / "firefox"
        if rel.exists():
            firefox_dir = rel
    if not firefox_dir.exists():
        return []

    # Collect all directories that contain a prefs.js
    profiles = []
    for pf in firefox_dir.glob("*.default*/prefs.js"):
        profiles.append(pf.parent)
    for pf in firefox_dir.glob("*.default-release*/prefs.js"):
        profiles.append(pf.parent)
    for pf in firefox_dir.glob("*.Profile */prefs.js"):
        profiles.append(pf.parent)

    # Deduplicate
    return sorted(set(profiles), key=lambda p: p.name)


def _set_prefs_js_proxy(profile, socks_host="127.0.0.1", socks_port=1080):
    """Update prefs.js directly so proxy works even if user.js is stale."""
    prefs = profile / "prefs.js"
    if not prefs.exists():
        return False

    lines = prefs.read_text(encoding="utf-8", errors="replace").splitlines(True)
    new_lines = []
    seen_type = False
    seen_socks = False
    seen_socks_port = False
    seen_no_proxies = False
    seen_tls = False
    seen_remote_dns = False

    for line in lines:
        s = line.strip()
        if 'network.proxy.type' in s:
            new_lines.append(f'user_pref("network.proxy.type", 1);\n')
            seen_type = True
        elif 'network.proxy.socks_port' in s:
            new_lines.append(f'user_pref("network.proxy.socks_port", {socks_port});\n')
            seen_socks_port = True
        elif 'network.proxy.socks"' in s or 'network.proxy.socks,' in s:
            new_lines.append(f'user_pref("network.proxy.socks", "{socks_host}");\n')
            seen_socks = True
        elif 'network.proxy.no_proxies_on' in s:
            new_lines.append('user_pref("network.proxy.no_proxies_on", "localhost, 127.0.0.1");\n')
            seen_no_proxies = True
        elif 'network.proxy.proxy_over_tls' in s:
            new_lines.append('user_pref("network.proxy.proxy_over_tls", false);\n')
            seen_tls = True
        elif 'network.proxy.socks_remote_dns' in s:
            new_lines.append('user_pref("network.proxy.socks_remote_dns", true);\n')
            seen_remote_dns = True
        else:
            new_lines.append(line)

    if not seen_type:
        new_lines.append('user_pref("network.proxy.type", 1);\n')
    if not seen_socks:
        new_lines.append(f'user_pref("network.proxy.socks", "{socks_host}");\n')
    if not seen_socks_port:
        new_lines.append(f'user_pref("network.proxy.socks_port", {socks_port});\n')
    if not seen_no_proxies:
        new_lines.append('user_pref("network.proxy.no_proxies_on", "localhost, 127.0.0.1");\n')
    if not seen_tls:
        new_lines.append('user_pref("network.proxy.proxy_over_tls", false);\n')
    if not seen_remote_dns:
        new_lines.append('user_pref("network.proxy.socks_remote_dns", true);\n')

    prefs.write_text("".join(new_lines), encoding="utf-8")
    return True


def _clear_prefs_js_proxy(profile):
    """Set proxy type to 0 (direct) and neuter socks entries."""
    prefs = profile / "prefs.js"
    if not prefs.exists():
        return False

    lines = prefs.read_text(encoding="utf-8", errors="replace").splitlines(True)
    new_lines = []
    for line in lines:
        s = line.strip()
        if 'network.proxy.type' in s:
            new_lines.append('user_pref("network.proxy.type", 0);\n')
        elif 'network.proxy.socks_port' in s:
            new_lines.append('user_pref("network.proxy.socks_port", 0);\n')
        elif 'network.proxy.socks"' in s or 'network.proxy.socks,' in s:
            new_lines.append('user_pref("network.proxy.socks", "");\n')
        elif 'network.proxy.no_proxies_on' in s:
            new_lines.append('user_pref("network.proxy.no_proxies_on", "");\n')
        elif 'network.proxy.proxy_over_tls' in s:
            new_lines.append('user_pref("network.proxy.proxy_over_tls", false);\n')
        elif 'network.proxy.socks_remote_dns' in s:
            new_lines.append('user_pref("network.proxy.socks_remote_dns", false);\n')
        else:
            new_lines.append(line)
    prefs.write_text("".join(new_lines), encoding="utf-8")
    return True


def set_firefox_proxy(socks_host="127.0.0.1", socks_port=1080):
    """Configure all Firefox profiles to use the SOCKS5 proxy."""
    firefox_dir = Path.home() / ".config" / "mozilla" / "firefox"
    if not firefox_dir.exists():
        firefox_dir = Path.home() / ".mozilla" / "firefox"
    if not firefox_dir.exists():
        print(f"\u26a0 Firefox directory not found")
        return

    profiles = _find_firefox_profiles()
    if not profiles:
        print("\u26a0 No Firefox profiles found")
        return

    print(f"\U0001f980 Configuring Firefox proxy for {len(profiles)} profiles...")

    for profile in profiles:
        user_js = profile / "user.js"
        # Remove any existing user.js (which would override prefs.js on every launch)
        if user_js.exists():
            user_js.unlink()
        # Also remove stale backups
        bak = profile / "user.js.outline-bak"
        if bak.exists():
            bak.unlink()

        # Write prefs.js entries directly
        _set_prefs_js_proxy(profile, socks_host, socks_port)

        print(f"  \u2713 {profile.name}  \u2192 socks5://{socks_host}:{socks_port}")


def clear_firefox_proxy():
    """Clear proxy settings from ALL Firefox profiles."""
    firefox_dir = Path.home() / ".config" / "mozilla" / "firefox"
    if not firefox_dir.exists():
        firefox_dir = Path.home() / ".mozilla" / "firefox"
    if not firefox_dir.exists():
        return

    profiles = _find_firefox_profiles()
    if not profiles:
        return

    print(f"\U0001f980 Clearing Firefox proxy for {len(profiles)} profiles...")

    for profile in profiles:
        # Nuke user.js (Outline-created override file)
        user_js = profile / "user.js"
        if user_js.exists():
            user_js.unlink()
        bak = profile / "user.js.outline-bak"
        if bak.exists():
            bak.unlink()

        # Reset prefs.js proxy entries
        _clear_prefs_js_proxy(profile)

        print(f"  \u2713 {profile.name}")


if __name__ == "__main__":
    import argparse
    ap = argparse.ArgumentParser(description="Configure Firefox SOCKS5 proxy")
    ap.add_argument("--port", type=int, default=1080, help="SOCKS5 port (default 1080)")
    ap.add_argument("--host", default="127.0.0.1", help="SOCKS5 host")
    ap.add_argument("command", nargs="?", default="set", choices=["set", "clear", "status"])
    args = ap.parse_args()

    if args.command == "clear":
        clear_firefox_proxy()
    elif args.command == "status":
        profiles = _find_firefox_profiles()
        print(json.dumps({"profile_count": len(profiles), "profiles": [str(p.name) for p in profiles]}))
    else:
        set_firefox_proxy(args.host, args.port)
