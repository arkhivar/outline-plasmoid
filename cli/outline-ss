#!/usr/bin/env python3
"""
outline-ss — CLI for Outline-compatible client management.

Commands:
    outline-ss connect <ssconf-url> [--profile NAME] [--local-port PORT]
    outline-ss disconnect [--profile NAME]
    outline-ss status [--profile NAME]
"""

import argparse
import base64
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

SYSTEMCTL = ["systemctl", "--user", "--no-pager"]
SERVICE_TEMPLATE = "outline-ss@{profile}.service"
CONF_TEMPLATE = "outline-ss@{profile}.json"
DEFAULT_PROFILE = "default"
DEFAULT_LOCAL_PORT = 1080
POOL_PORT = 1081
POOL_COOLDOWN = 5.0
FETCH_TIMEOUT = 15
CUSTOM_CA_BUNDLE = os.path.expanduser("~/.config/outline-ss/ca-bundle.crt")
CONF_DIR = os.path.expanduser("~/.config/outline-ss")
STATUS_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "outline-ss")
BACKEND_ENV = "OUTLINE_SS_BACKEND"


def _run(args, capture=True, check=False):
    try:
        r = subprocess.run(args, capture_output=capture, text=True, timeout=30)
        if check and r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"exit code {r.returncode}")
        return r.stdout.strip() if capture else ""
    except subprocess.TimeoutExpired:
        raise RuntimeError("Command timed out")


def _service_name(profile):
    return SERVICE_TEMPLATE.format(profile=profile)


def _conf_path(profile):
    return os.path.join(CONF_DIR, CONF_TEMPLATE.format(profile=profile))


def _status_path(profile):
    Path(STATUS_DIR).mkdir(parents=True, exist_ok=True)
    return os.path.join(STATUS_DIR, f"status-{profile}.json")


def _parse_ssconf_url(url: str):
    m = re.match(r'^ssconf://([^:/]+)(?::(\d+))?(/.*)?$', url)
    if not m:
        raise ValueError(f"Invalid ssconf:// URL: {url}")
    host = m.group(1)
    port = int(m.group(2)) if m.group(2) else 443
    path = m.group(3) or "/"
    return host, port, path


def _create_ssl_context():
    if os.path.isfile(CUSTOM_CA_BUNDLE):
        return ssl.create_default_context(cafile=CUSTOM_CA_BUNDLE)
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def _fetch_raw_config(host: str, port: int, path: str):
    url = f"https://{host}:{port}{path}"
    ctx = _create_ssl_context()
    req = urllib.request.Request(url, headers={"User-Agent": "outline-ss/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT, context=ctx) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Failed to fetch {host}:{port}{path}: {e.reason}")
    except Exception as e:
        raise RuntimeError(f"Failed to fetch {host}:{port}{path}: {e}")

    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        pass

    try:
        return _parse_simple_yaml(raw)
    except Exception:
        pass

    raise RuntimeError(f"Could not parse config from {host}:{port}{path}. Response starts with: {raw[:200]}")


def _fetch_config(host: str, port: int, path: str):
    return _normalize_json_config(_fetch_raw_config(host, port, path))


def _parse_simple_yaml(raw: str):
    result = {}
    raw = re.sub(r'^---\s*\n', '', raw)
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith('#') or ':' not in line:
            continue
        key, _, val = line.partition(':')
        key = key.strip()
        val = val.strip().strip('"').strip("'")
        if val.isdigit():
            val = int(val)
        elif val.lower() in ('true', 'false'):
            val = val.lower() == 'true'
        result[key] = val
    return result


def _normalize_json_config(data: dict):
    return {
        "server": data.get("server") or data.get("serverHost") or data.get("host", ""),
        "server_port": data.get("server_port") or data.get("serverPort") or data.get("port", 0),
        "method": data.get("method") or data.get("cipher") or "chacha20-ietf-poly1305",
        "password": data.get("password") or data.get("secret") or "",
        "prefix": data.get("prefix") or None,
        "plugin": data.get("plugin") or None,
        "plugin_opts": data.get("plugin_opts") or data.get("pluginOpts") or None,
    }


def _generate_go_config(config: dict, local_port: int):
    """Generate config in the format outline-go-tun2socks expects.
    
    The Outline API returns prefix as a Unicode string where each codepoint
    maps 1:1 to a raw byte. outline-go-tun2socks expects exactly this format.
    Unlike sslocal (which needs base64), the Go client handles Unicode prefix natively.
    """
    out = {
        "host": config["server"],
        "port": int(config["server_port"]),
        "method": config["method"],
        "password": config["password"],
    }
    if config.get("prefix"):
        # API returns prefix as unicode string with one codepoint per byte
        # Pass it through directly - the Go library decodes with DecodeUTF8CodepointsToRawBytes
        out["prefix"] = config["prefix"]
    return json.dumps(out, ensure_ascii=False)


def _generate_backend_config(config: dict, local_port: int):
    out = {
        "server": config["server"],
        "server_port": int(config["server_port"]),
        "method": config["method"],
        "password": config["password"],
        "local_address": "127.0.0.1",
        "local_port": int(local_port),
        "mode": "tcp_only",
    }
    if config.get("prefix"):
        # The Outline API returns prefix as a unicode string where each codepoint
        # maps 1:1 to a raw byte (latin-1 encoding). sslocal expects base64.
        # Direct unicode passthrough causes UTF-8 re-encoding and corrupts the bytes.
        raw_bytes = bytes(ord(c) for c in config["prefix"])
        out["prefix"] = base64.b64encode(raw_bytes).decode()
    if config.get("plugin"):
        out["plugin"] = config["plugin"]
    if config.get("plugin_opts"):
        out["plugin_opts"] = config["plugin_opts"]
    return json.dumps(out, indent=2)


def _write_config(profile: str, config: dict, local_port: int):
    path = _conf_path(profile)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    content = _generate_backend_config(config, local_port)
    tmp_path = path + ".tmp"
    with open(tmp_path, "w") as f:
        f.write(content)
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, path)
    return path


def _backend_candidates():
    env = os.environ.get(BACKEND_ENV, "").strip()
    candidates = []
    if env:
        candidates.append(env)
    candidates.extend([
        # Prefer the official Go Outline proxy (same library as Windows/Android)
        os.path.expanduser("~/.local/bin/outline-go-proxy"),
        shutil.which("outline-go-proxy") or "",
        os.path.expanduser("~/.local/lib/outline/outline-local"),
        os.path.expanduser("~/.local/bin/outline-local"),
        "/usr/local/libexec/outline-local",
        "/usr/local/bin/outline-local",
        "/usr/bin/outline-local",
        "/opt/outline/resources/outline-local",
        "/opt/Outline/outline-local",
        "/usr/local/bin/sslocal",
        shutil.which("sslocal") or "",
    ])
    seen = set()
    for cand in candidates:
        cand = cand.strip()
        if not cand or cand in seen:
            continue
        seen.add(cand)
        yield cand


def _detect_backend():
    for cand in _backend_candidates():
        if os.path.isabs(cand):
            if os.path.exists(cand) and os.access(cand, os.X_OK):
                return cand
        else:
            resolved = shutil.which(cand)
            if resolved:
                return resolved
    raise RuntimeError(
        "No supported Outline backend found. Set OUTLINE_SS_BACKEND to the official Linux Outline local client binary."
    )


PID_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "outline-ss")


def _pid_path(profile: str):
    Path(PID_DIR).mkdir(parents=True, exist_ok=True)
    return os.path.join(PID_DIR, f"pid-{profile}")


def _log_path(profile: str):
    return os.path.join(CONF_DIR, f"outline-ss@{profile}.log")


def _read_pid(profile: str):
    try:
        return int(Path(_pid_path(profile)).read_text().strip())
    except Exception:
        return None


def _proc_alive(pid: int):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def _start_backend(profile: str, backend: str, conf_path: str):
    """Launch backend directly as a detached child (no systemd)."""
    log = open(_log_path(profile), "a")
    # outline-go-proxy uses --config flag, sslocal uses -c flag
    if "go-proxy" in backend:
        cmd = [backend, "--config", conf_path]
    else:
        cmd = [backend, "-c", conf_path]
    proc = subprocess.Popen(
        cmd,
        stdout=log,
        stderr=log,
        stdin=subprocess.DEVNULL,
        start_new_session=True,  # detach from our process group
    )
    Path(_pid_path(profile)).write_text(str(proc.pid))
    log.close()
    return proc.pid


def _stop_backend(profile: str):
    """Stop the detached backend process."""
    import signal
    pid = _read_pid(profile)
    if pid and _proc_alive(pid):
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(20):
                time.sleep(0.15)
                if not _proc_alive(pid):
                    break
            if _proc_alive(pid):
                os.kill(pid, signal.SIGKILL)
        except Exception:
            pass
    try:
        os.unlink(_pid_path(profile))
    except FileNotFoundError:
        pass


def _backend_running(profile: str):
    pid = _read_pid(profile)
    return pid is not None and _proc_alive(pid)


def _service_active(profile: str):
    # Check our direct PID first, fall back to systemd
    if _backend_running(profile):
        return True
    try:
        return _run(SYSTEMCTL + ["is-active", _service_name(profile)]) == "active"
    except Exception:
        return False


def _check_tcp(host="127.0.0.1", port=DEFAULT_LOCAL_PORT):
    import socket
    try:
        s = socket.create_connection((host, port), timeout=2)
        s.close()
        return True
    except (socket.timeout, ConnectionRefusedError, OSError):
        return False


# ── Connection pool (sits between browsers and sslocal) ──────────────

def _pool_script():
    """Return path to the pool proxy script."""
    return shutil.which("outline-ss-pool") or os.path.expanduser("~/.local/bin/outline-ss-pool")


def _pool_pid_path(profile: str):
    return os.path.join(PID_DIR, f"pool-pid-{profile}")


def _pool_running(profile: str):
    try:
        pid = int(Path(_pool_pid_path(profile)).read_text().strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _start_pool(profile: str):
    """Start the connection-pool proxy on POOL_PORT → 127.0.0.1:DEFAULT_LOCAL_PORT."""
    script = _pool_script()
    if not script:
        sys.stderr.write("Warning: outline-ss-pool not found, skipping pool\n")
        return None
    log = open(_log_path(profile), "a")
    proc = subprocess.Popen(
        [sys.executable, script,
         "--listen", f"127.0.0.1:{POOL_PORT}",
         "--upstream", f"127.0.0.1:{DEFAULT_LOCAL_PORT}",
         "--max-conn", "2",
         "--cooldown", str(POOL_COOLDOWN),
         "--log-level", "INFO"],
        stdout=log,
        stderr=log,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    Path(_pool_pid_path(profile)).write_text(str(proc.pid))
    log.close()
    return proc.pid


def _stop_pool(profile: str):
    """Stop the pool proxy process."""
    import signal
    try:
        pid = int(Path(_pool_pid_path(profile)).read_text().strip())
    except Exception:
        return
    if _proc_alive(pid):
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(20):
                time.sleep(0.15)
                if not _proc_alive(pid):
                    break
            if _proc_alive(pid):
                os.kill(pid, signal.SIGKILL)
        except Exception:
            pass
    try:
        os.unlink(_pool_pid_path(profile))
    except FileNotFoundError:
        pass


# ── KDE / Firefox proxy helpers ──────────────────────────────────────


def _set_kde_proxy(host="127.0.0.1", port=1080):
    try:
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "socksProxy", f"socks5://{host}:{port}"], check=True)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "httpProxy", f"socks5://{host}:{port}"], check=True)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "httpsProxy", f"socks5://{host}:{port}"], check=True)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "ProxyType", "--type", "int", "1"], check=True)
        _run(["dbus-send", "--session", "--dest=org.kde.kded6", "/kded", "org.kde.kded6.reconfigure"], check=False)
        qdbus_bin = shutil.which("qdbus-qt6") or "qdbus"
        _run([qdbus_bin, "org.kde.kded6", "/modules/proxyscout", "reload"], check=False)
        sys.stderr.write(f"✓ System proxy set to {host}:{port}\n")
    except Exception as e:
        sys.stderr.write(f"Warning: failed to set KDE proxy: {e}\n")


def _clear_kde_proxy():
    try:
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "ProxyType", "--type", "int", "0"], check=False)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "socksProxy", "--delete"], check=False)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "httpProxy", "--delete"], check=False)
        _run(["kwriteconfig6", "--file", "kioslaverc", "--group", "Proxy Settings", "--key", "httpsProxy", "--delete"], check=False)
        _run(["dbus-send", "--session", "--dest=org.kde.kded6", "/kded", "org.kde.kded6.reconfigure"], check=False)
        sys.stderr.write("✓ System proxy cleared\n")
    except Exception as e:
        sys.stderr.write(f"Warning: failed to clear KDE proxy: {e}\n")


def _cleanup_proxy():
    _clear_kde_proxy()
    ff_proxy = shutil.which("configure-firefox-proxy")
    if ff_proxy:
        subprocess.run([ff_proxy, "clear"], check=False)


def _write_status(profile: str, config: dict, local_port: int, backend: str):
    status = {
        "server": config["server"],
        "server_port": config["server_port"],
        "method": config["method"],
        "local_port": local_port,
        "backend": backend,
        "status": "connected",
    }
    spath = _status_path(profile)
    with open(spath, "w") as f:
        json.dump(status, f)
    os.chmod(spath, 0o600)


def cmd_connect(url: str, profile: str = DEFAULT_PROFILE, local_port: int = DEFAULT_LOCAL_PORT):
    if not url.startswith("ssconf://"):
        if re.match(r'^[\w.-]+:\d+', url) or url.startswith("https://"):
            url = url.replace("https://", "ssconf://", 1) if url.startswith("https://") else f"ssconf://{url}"
        else:
            print("error: URL must start with ssconf:// or be a host:port/path", file=sys.stderr)
            sys.exit(1)
    try:
        backend = _detect_backend()
        # Stop any existing instance (direct or systemd)
        if _backend_running(profile):
            _stop_backend(profile)
        if _pool_running(profile):
            _stop_pool(profile)
        _run(SYSTEMCTL + ["stop", _service_name(profile)], check=False)
        for _ in range(10):
            if not _check_tcp(port=local_port):
                break
            time.sleep(0.3)
        host, port, path = _parse_ssconf_url(url)
        sys.stderr.write(f"Fetching config from {host}:{port}{path}...\n")
        config = _fetch_config(host, port, path)
        # Generate config in the format the backend expects
        is_go = "go-proxy" in backend
        if is_go:
            # Go backend expects API-native JSON (host/port/prefix in unicode)
            conf_path = _conf_path(profile).replace(".json", "-go.json")
            os.makedirs(os.path.dirname(conf_path), exist_ok=True)
            content = _generate_go_config(config, local_port)
            with open(conf_path, "w") as f:
                f.write(content)
            os.chmod(conf_path, 0o600)
        else:
            conf_path = _write_config(profile, config, local_port)
        sys.stderr.write(f"Config: {conf_path} (backend={backend}, server={config['server']}:{config['server_port']})\n")
        pid = _start_backend(profile, backend, conf_path)
        sys.stderr.write(f"Started backend pid={pid}, log={_log_path(profile)}\n")
        # Wait for port to open
        for _ in range(20):
            if _check_tcp(port=local_port):
                break
            time.sleep(0.2)
        _write_status(profile, config, local_port, backend)
        _set_kde_proxy("127.0.0.1", local_port)
        ff_proxy = shutil.which("configure-firefox-proxy")
        if ff_proxy:
            _run([ff_proxy, "--port", str(local_port)], check=False)
        print("ok" if _check_tcp(port=local_port) else "ok (starting)")
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_disconnect(profile: str = DEFAULT_PROFILE):
    try:
        _stop_pool(profile)
        _stop_backend(profile)
        _run(SYSTEMCTL + ["stop", _service_name(profile)], check=False)
        time.sleep(0.3)
        _cleanup_proxy()
        print("ok")
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_cleanup(profile: str = DEFAULT_PROFILE):
    try:
        _stop_pool(profile)
        _clear_kde_proxy()
        ff_proxy = shutil.which("configure-firefox-proxy")
        if ff_proxy:
            subprocess.run([ff_proxy, "clear"], check=False)
        print("ok")
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_recover():
    print("Emergency recovery: purging ALL Outline proxy residues...", file=sys.stderr)
    _stop_pool(DEFAULT_PROFILE)
    _stop_backend(DEFAULT_PROFILE)
    _run(SYSTEMCTL + ["stop", _service_name(DEFAULT_PROFILE)], check=False)
    _clear_kde_proxy()
    ff_proxy = shutil.which("configure-firefox-proxy")
    if ff_proxy:
        subprocess.run([ff_proxy, "clear"], check=False)
    print("ok", file=sys.stderr)


def cmd_debug_config(url: str):
    if not url.startswith("ssconf://"):
        if re.match(r'^[\w.-]+:\d+', url) or url.startswith("https://"):
            url = url.replace("https://", "ssconf://", 1) if url.startswith("https://") else f"ssconf://{url}"
    host, port, path = _parse_ssconf_url(url)
    raw = _fetch_raw_config(host, port, path)
    norm = _normalize_json_config(raw)
    gen = _generate_backend_config(norm, DEFAULT_LOCAL_PORT)
    print("=== Raw Outline response ===")
    print(json.dumps(raw, indent=2))
    print("\n=== Normalized ===")
    print(json.dumps({k: v for k, v in norm.items() if v is not None}, indent=2))
    print("\n=== Generated backend config ===")
    print(gen)
    try:
        print("\n=== Detected backend ===")
        print(_detect_backend())
    except Exception as e:
        print("\n=== Detected backend ===")
        print(f"ERROR: {e}")


def cmd_status(profile: str = DEFAULT_PROFILE):
    running = _backend_running(profile)
    status = {
        "status": "connected" if running else "disconnected",
        "local_port": DEFAULT_LOCAL_PORT,
    }
    if running:
        status["pid"] = _read_pid(profile)
    spath = _status_path(profile)
    if os.path.isfile(spath):
        try:
            with open(spath) as f:
                saved = json.load(f)
            status.update({k: v for k, v in saved.items() if k != "status"})
        except Exception:
            pass
    print(json.dumps(status))


def main():
    parser = argparse.ArgumentParser(prog="outline-ss", description="Outline client CLI")
    sub = parser.add_subparsers(dest="command", required=True)
    p_connect = sub.add_parser("connect", help="Connect to Outline server")
    p_connect.add_argument("url", help="ssconf:// URL (or host:port/path)")
    p_connect.add_argument("--profile", "-p", default=DEFAULT_PROFILE, help="Profile name (default: default)")
    p_connect.add_argument("--local-port", "-l", type=int, default=DEFAULT_LOCAL_PORT, help="Local SOCKS5 port")
    p_disconnect = sub.add_parser("disconnect", help="Disconnect from Outline server")
    p_disconnect.add_argument("--profile", "-p", default=DEFAULT_PROFILE, help="Profile name")
    p_cleanup = sub.add_parser("cleanup", help="Clean up proxy settings (for systemd hooks)")
    p_cleanup.add_argument("--profile", "-p", default=DEFAULT_PROFILE, help="Profile name")
    sub.add_parser("recover", help="Emergency: purge ALL proxy residues")
    p_debug = sub.add_parser("debug-config", help="Debug: fetch and print generated backend config")
    p_debug.add_argument("url", help="ssconf:// URL")
    p_status = sub.add_parser("status", help="Show connection status")
    p_status.add_argument("--profile", "-p", default=DEFAULT_PROFILE, help="Profile name")
    args = parser.parse_args()
    if args.command == "connect":
        cmd_connect(args.url, args.profile, args.local_port)
    elif args.command == "disconnect":
        cmd_disconnect(args.profile)
    elif args.command == "cleanup":
        cmd_cleanup(args.profile)
    elif args.command == "recover":
        cmd_recover()
    elif args.command == "debug-config":
        cmd_debug_config(args.url)
    elif args.command == "status":
        cmd_status(args.profile)


if __name__ == "__main__":
    main()
