[Unit]
Description=Outline Shadowsocks Client (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sslocal -c %h/.config/systemd/user/outline-ss@%i.conf
# Defense in depth: cleanup runs on ANY stop (manual, crash, or reboot)
ExecStopPost=-%h/.local/bin/outline-ss cleanup --profile %i
Restart=on-failure
RestartSec=5

[Install]
# graphical-session.target ensures abrupt logouts/reboots trigger ExecStopPost
WantedBy=graphical-session.target
